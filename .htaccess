Options -Indexes
RewriteEngine On

<FilesMatch "(^\.|\.(env|ini|log|sql|sqlite|lock|md|yml|yaml)$|^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$)">
    Require all denied
</FilesMatch>

# Block direct web requests while allowing Apache's internal front-controller rewrite.
RewriteCond %{THE_REQUEST} \s/+(.*/)?server\.php(?:[\s?]|$) [NC]
RewriteRule ^server\.php$ - [F,L]

# Let the internally rewritten front controller execute on the next rewrite pass.
RewriteRule ^server\.php$ - [L]

# Serve public assets without exposing /public in their URLs. Dynamic XML routes
# such as the sitemap continue through Laravel.
RewriteCond %{REQUEST_URI} !/sitemap\.xml$ [NC]
RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
RewriteRule ^(.*)$ public/$1 [L]

RewriteRule ^ server.php [L]
